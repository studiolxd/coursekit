# Personal settings for this coursekit project. Copy to .env and fill in; .env is never
# committed. Real environment variables take precedence. Paths with spaces go between quotes.

# Identity used to sign approvals (`coursekit approve`) and in the course history.
COURSEKIT_USER_NAME=
COURSEKIT_USER_EMAIL=
# Language of coursekit messages for you (overrides project.yaml › ui_language).
COURSEKIT_LANG=

# Local path of the mirror folder (project.yaml › mirror), synced by its desktop client.
MIRROR_DIR=

# Tool and model for each role. Tool: claude | opencode | codex. Model: an id that tool
# understands (opencode: provider/model). Empty model: the tool's default. One-off override:
# --agent TOOL --model MODEL. Better a reviewer other than the writer's tool and model.
DESIGN_AGENT=claude
DESIGN_MODEL=
WRITER_AGENT=claude
WRITER_MODEL=
REVIEWER_AGENT=claude
REVIEWER_MODEL=
MEDIA_AGENT=claude
MEDIA_MODEL=
# Illustration (SVG drawn by the agent): empty AGENT and MODEL use the media role's.
ILLUSTRATION_AGENT=
ILLUSTRATION_MODEL=
ASSEMBLY_AGENT=claude
ASSEMBLY_MODEL=

# Multimedia providers (optional): each one is used only if its key is set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
GEMINI_API_KEY=
GEMINI_TTS_VOICE=
MAGNIFIC_API_KEY=
PIPER_VOICE=
PIPER_SPEAKER=0

# Web research (optional): `coursekit research` looks for official sources with this provider and its key
# (exa | perplexity | brave | tavily). A key alone does nothing; without both, the agents use their own web search.
RESEARCH_PROVIDER=
EXA_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
